rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    match /users/{userId}/optimizations/{optId} {
      function isValidOptimization(data) {
        return data.keys().hasAll(['inputTokens', 'outputTokens', 'savedTokens']) 
            && data.keys().size() >= 3
            && data.inputTokens is number
            && data.outputTokens is number
            && data.savedTokens is number;
      }
      
      allow read: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidOptimization(incoming());
      
      allow list: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
    }
    match /users/{userId}/settings/{settingId} {
      allow read: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(settingId);
    }
  }
}
